.ui-root {
    --start-top-inset: 0.12;
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Fredoka-Bold.asset");
    font-size: 58px;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(48, 25, 72);
    -unity-text-outline-width: 2px;
    text-shadow: 0 4px 0 rgba(27, 12, 45, 0.65);
}
.fill { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hidden { display: none; }
.art-comparison { -unity-background-scale-mode: scale-to-fit; }
.safe-area { flex-grow: 1; }
.start-screen { justify-content: flex-start; }
.ready-dim { background-color: rgba(10, 15, 31, 0.22); }
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 22px;
    height: 202px;
    flex-shrink: 0;
}
.start-bar { position: absolute; left: 0; right: 0; top: 0; justify-content: flex-start; padding-left: 0; padding-right: 3.5%; padding-top: 0; height: 127.4px; align-items: flex-start; }
.start-bar > .lives-plate { margin-left: 22%; }
.start-bar > .gear { margin-left: auto; }
.start-bar > .counter { width: 304.2px; height: 127.4px; margin-right: 18.2px; padding-right: 13px; }
.start-bar .heart-icon, .start-bar .coin-icon { width: 127.4px; height: 127.4px; }
.start-bar .counter-text { font-size: 52px; }
.start-bar .lives-count { font-size: 55.9px; }
.start-bar .coin-plus { width: 52px; height: 53.3px; right: -1.3px; }
.start-bar > .gear { width: 117px; height: 119.6px; }
.counter {
    flex-direction: row;
    align-items: center;
    width: 216px;
    height: 88px;
    flex-shrink: 0;
    margin-right: 14px;
    padding-right: 10px;
}
.counter-text { flex-grow: 1; font-size: 31px; padding: 0; margin: 0; -unity-text-outline-color: #10121c; -unity-text-outline-width: 1.6px; text-shadow: 0 2px 0 #081423; }
.heart-icon, .coin-icon { width: 88px; height: 88px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.heart-icon { background-image: url("Vector/icon_heart.svg"); justify-content: center; }
.lives-count { font-size: 33px; padding: 0; margin: 0; -unity-text-outline-color: #161217; -unity-text-outline-width: 1.8px; text-shadow: 0 2px 0 #42151d; }
.coin-icon { background-image: url("Vector/icon_coin.svg"); }
.coin-plus { position: absolute; right: -1px; bottom: 0; width: 34px; height: 35px; background-image: url("Vector/hud_coin_plus.svg"); -unity-background-scale-mode: scale-to-fit; }
.coin-number-wrap { flex-grow: 1; flex-basis: 0; min-width: 0; height: 100%; scale: .67 .67; justify-content: center; }
Button { border-width: 0; margin: 0; padding: 0; background-color: transparent; color: white; -unity-font-style: normal; }
.gear { width: 78px; height: 80px; flex-shrink: 0; background-image: url("Vector/btn_settings.svg"); -unity-background-scale-mode: scale-to-fit; }
.gear:hover { background-image: url("Vector/btn_settings_hover.svg"); }
.gear:active { background-image: url("Vector/btn_settings_pressed.svg"); }
.gear:active, .close-button:active { scale: 0.92 0.92; }
.start-body { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; }
.art-button {
    width: 338px; max-width: 100%; height: 146px; min-height: 110px;
    flex-shrink: 0; font-size: 46px;
}
.start-button { position: absolute; left: 50%; translate: -50% 0; bottom: 19%; width: 474.5px; height: 228.8px; font-size: 98.8px; }
.start-button.art-button > .vector-caption { font-size: 88.4px; padding-bottom: 15.6px; }
.level-badge {
    width: 106px; height: 110px; flex-shrink: 0; justify-content: center;
}
.level-title { height: 31px; font-size: 28px; padding: 0; margin: 0; color: #241832; -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent; }
.level-number { height: 62px; font-size: 70px; padding: 0; margin: 0; -unity-text-outline-color: #211b26; -unity-text-outline-width: 2.5px; text-shadow: 0 2px 0 #45364c; }
.timer-counter {
    width: 216px; height: 88px; flex-shrink: 0; flex-direction: row; align-items: center; padding-right: 10px;
}
.clock-icon { width: 82px; height: 86px; flex-shrink: 0; background-image: url("Vector/icon_clock.svg"); -unity-background-scale-mode: scale-to-fit; }
.timer-text { flex-grow: 1; padding: 0; margin: 0; font-size: 35px; -unity-text-outline-color: #10121c; -unity-text-outline-width: 1.6px; text-shadow: 0 2px 0 #081423; }
.urgent { color: rgb(255, 41, 46); }
.ready-overlay { align-items: center; justify-content: center; }
.ready-prompt { font-size: 88px; }
.modal-overlay { align-items: center; justify-content: center; background-color: rgba(5, 5, 13, 0.8); }
.modal {
    width: 864px; max-width: 92%; max-height: 92%;
    align-items: center; justify-content: space-around;
    padding: 66px 64px;
}
.settings-modal { min-height: 640px; }
.pause-modal { height: 1000px; }
.modal-heading {
    width: 100%; height: 160px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between;
    padding-left: 28px; padding-right: 16px;
}
.modal-title { flex-grow: 1; font-size: 64px; }
.close-button { width: 82px; height: 84px; flex-shrink: 0; background-image: url("Vector/icon_close.svg"); -unity-background-scale-mode: scale-to-fit; }
.close-button:hover { background-image: url("Vector/icon_close_hover.svg"); }
.close-button:active { background-image: url("Vector/icon_close_pressed.svg"); }
.confirmation { width: 100%; align-items: center; }
.question { white-space: normal; font-size: 58px; margin: 20px 0 32px 0; -unity-text-align: middle-center; }
.button-row { width: 100%; flex-direction: row; justify-content: space-between; }
.button-row .art-button { width: 46%; height: 140px; font-size: 56px; }
.confirm-modal { min-height: 560px; }
.sound-toggle {
    width: 100%; height: 130px; flex-shrink: 0; flex-direction: row; align-items: center;
    padding-left: 30px; padding-right: 20px;
}
.sound-toggle > .unity-toggle__label { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: 56px; }
.sound-toggle > .unity-toggle__input { width: 96px; min-width: 96px; height: 96px; flex-grow: 0; flex-shrink: 0; }
.sound-toggle .unity-toggle__checkmark { width: 96px; height: 96px; border-width: 0; background-color: transparent; background-image: none; }

.square .start-button { bottom: 18.5%; }
.landscape .start-button { bottom: 8%; width: 572px; height: 234px; }
.square .top-bar, .landscape .top-bar { padding-top: 20px; }
.square .start-bar > .lives-plate, .landscape .start-bar > .lives-plate { margin-left: 0; }
.square .start-bar, .landscape .start-bar { justify-content: flex-end; }
.square .start-bar > .gear, .landscape .start-bar > .gear { margin-left: 0; }
.square .start-bar, .landscape .start-bar { padding-top: 0; }
/* Result art is constructed from glyph paths and stays sharp at every viewport. */
.result-overlay { background-color: rgba(8, 8, 43, 0.86); }
.result-bar { justify-content: flex-end; flex-shrink: 0; }
.result-body { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.result-content { position: absolute; left: 50%; top: 0; width: 739px; height: 1600px; translate: -50% 0; transform-origin: 50% 0; }
/* Normal level win (R8): title on a blue ribbon; halo, two counter-rotating ray layers, burst, dust and twinkles behind it. */
.result-heading { position: absolute; left: 0; top: 110px; width: 739px; height: 380px; }
.complete-title { position: absolute; left: 60px; top: 50px; width: 620px; height: 255px; background-image: url("Vector/title_complete.svg"); -unity-background-scale-mode: scale-to-fit; }
.complete-ribbon { position: absolute; left: 10px; top: 162px; width: 719px; height: 216px; background-image: url("Vector/ribbon_blue.svg"); -unity-background-scale-mode: scale-to-fit; }
.result-halo { position: absolute; left: -131px; top: -170px; width: 1000px; height: 700px; background-image: url("Vector/glow_soft.svg"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: #8fc0ff; }
.result-rays-frame { position: absolute; left: -51px; top: -236px; width: 840px; height: 840px; }
.result-rays { background-image: url("Vector/result_rays.svg"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #cfe6ff; }
.rays-back { -unity-background-image-tint-color: #7fb2ff; scale: 1.18 1.18; }
.result-burst { position: absolute; left: 89px; top: 10px; width: 560px; height: 360px; background-image: url("Vector/glow_soft.svg"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: #f4fbff; }
.result-dust { width: 26px; height: 26px; background-image: url("Vector/glow_soft.svg"); -unity-background-image-tint-color: #fff4c8; }
.reward-content { position: absolute; left: 0; right: 0; top: 700px; height: 400px; align-items: center; justify-content: flex-start; }
.reward-pile { width: 560px; height: 280px; margin-bottom: -6px; background-image: url("Vector/coin_pile.svg"); -unity-background-scale-mode: scale-to-fit; }
.reward-label { font-size: 88px; color: rgb(246, 244, 250); margin: 0; padding: 0; -unity-text-outline-color: #190e1e; -unity-text-outline-width: 6px; text-shadow: 3px 7px 0 #08060c; }
.reward-flash { background-image: url("Vector/glow_soft.svg"); -unity-background-scale-mode: scale-to-fit; }
.pooled-effect { position: absolute; left: 0; top: 0; -unity-background-scale-mode: scale-to-fit; }
.confetti-piece { width: 36px; height: 54px; background-image: url("Vector/fx_confetti_rect.svg"); }
.confetti-star { width: 54px; height: 54px; background-image: url("Vector/fx_confetti_star.svg"); }
.confetti-heart { width: 48px; height: 48px; background-image: url("Vector/fx_confetti_heart.svg"); }
.confetti-disc { width: 28px; height: 28px; background-image: url("Vector/fx_confetti_disc.svg"); }
.flying-coin { width: 58px; height: 58px; background-image: url("Vector/fx_flying_coin.svg"); }
.result-sparkle { width: 38px; height: 38px; background-image: url("Vector/fx_result_sparkle.svg"); }
.continue-wrap { position: absolute; left: 197px; top: 1207px; width: 345px; height: 146px; }
.continue-wrap .vector-caption { font-size: 48px; }
.continue-wrap > .art-button { width: 100%; height: 100%; }
.continue-glow { background-image: url("Vector/glow_soft.svg"); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: #ffe143; scale: 1.4 2.3; }
.life-float { width: 66px; height: 66px; background-image: url("Vector/icon_heart.svg"); }
.fail-bar { position: absolute; left: 0; right: 0; top: 0; }
.fail-hud .level-badge { visibility: hidden; }
.fail-modal { width: 486px; height: 850px; padding: 0; justify-content: flex-start; }
.fail-modal > .raster-panel-art.vector-modal { left: 0; right: 0; top: 0; bottom: 0; background-image: url("Vector/surface_result_modal.svg"); -unity-slice-left: 110; -unity-slice-right: 110; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: .48px; }
.fail-heading { position: absolute; left: 22px; right: 22px; top: 20px; height: 138px; align-items: center; justify-content: center; background-image: url("Vector/surface_result_header.svg"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 130; -unity-slice-right: 130; -unity-slice-top: 125; -unity-slice-bottom: 35; -unity-slice-scale: .5px; }
.fail-level { font-size: 56px; margin: 0; padding: 0; color: #fff9df; -unity-text-outline-color: #090d16; -unity-text-outline-width: 3px; text-shadow: 0 3px 0 #07101e; }
.fail-inner { position: absolute; left: 37px; right: 37px; top: 184px; height: 408px; align-items: center; background-image: url("Vector/surface_result_inner.svg"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 83; -unity-slice-right: 83; -unity-slice-top: 83; -unity-slice-bottom: 83; -unity-slice-scale: .48px; }
.fail-title { height: 48px; width: 100%; margin: 35px 0 12px 0; padding: 0; font-size: 29px; color: white; -unity-text-outline-color: #191919; -unity-text-outline-width: 1.8px; text-shadow: 0 2px 0 #242424; }
.life-loss { position: relative; width: 250px; height: 246px; flex-shrink: 0; align-items: center; justify-content: center; }
.fail-icon { position: absolute; left: 0; top: 0; width: 250px; height: 246px; -unity-background-scale-mode: scale-to-fit; }
.broken-heart { background-image: url("Vector/icon_heart_broken.svg"); }
.life-cost { position: absolute; left: 0; right: 0; top: 84px; height: 90px; margin: 0; padding: 0; font-size: 72px; color: white; -unity-text-outline-color: #080809; -unity-text-outline-width: 4px; text-shadow: 0 4px 0 #130c10; }
.fail-reason { font-size: 20px; height: 30px; margin: 5px 0 0 0; padding: 0; color: #28364e; -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent; }
.fail-modal > .close-button { position: absolute; right: -17px; top: -18px; width: 82px; height: 84px; }
.fail-modal > .art-button { position: absolute; bottom: 75px; width: 270px; height: 124px; font-size: 35px; }
.fail-modal > .art-button > .vector-caption { font-size: 35px; -unity-text-outline-color: #12230c; -unity-text-outline-width: 2px; text-shadow: 0 2px 0 #18300c; }
.no-lives-modal { height: 660px; }
.no-lives-hint { font-size: 42px; white-space: normal; }
.tutorial-overlay { justify-content: flex-end; align-items: center; padding-bottom: 180px; }
.tutorial-tip { width: 900px; max-width: 92%; padding: 35px 45px; background-image: url("Vector/panel_tip.svg"); -unity-background-scale-mode: stretch-to-fill; }
.tutorial-hint { margin: 0; padding: 0; white-space: normal; font-size: 46px; }
.tutorial-pointer { position: absolute; left: 0; top: 0; width: 0; height: 0; }
.tutorial-hand { position: absolute; left: -109px; top: -226px; width: 180px; height: 254px; background-image: url("Vector/fx_tap_hand.svg"); -unity-background-scale-mode: scale-to-fit; transform-origin: 61% 89%; }
.tutorial-ring { position: absolute; left: -50px; top: -50px; width: 100px; height: 100px; border-width: 5px; border-color: rgb(255, 232, 157); border-radius: 50px; background-image: url("Vector/glow_soft.svg"); -unity-background-scale-mode: scale-to-fit; }
.tutorial-dot { width: 24px; height: 24px; background-image: url("Vector/fx_sparkle.svg"); }
.landscape .tutorial-overlay { padding-bottom: 60px; }
/* Runtime level editor: game panel/socket/button art; the open workspace passes pointer input through to the board. */
.editor-root { font-size: 30px; -unity-text-outline-color: #10121c; -unity-text-outline-width: 1.5px; text-shadow: 0 2px 0 #081423; }
.editor-safe { flex-grow: 1; min-height: 0; padding: 4px 6px; }
.editor-surface {
    background-image: url("Vector/surface_result_modal.svg"); -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 110; -unity-slice-right: 110; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: .24px;
    margin: 3px 0;
}
.editor-top { padding: 14px 18px 10px 18px; flex-shrink: 0; }
.editor-row { flex-direction: row; align-items: center; flex-shrink: 0; min-width: 0; }
.editor-top > .editor-row { height: 92px; }
.editor-button { min-width: 120px; height: 84px; flex-shrink: 0; margin: 4px; padding: 0 18px; }
.editor-button > .vector-caption { font-size: 32px; padding-bottom: 7px; -unity-text-outline-width: 2px; -unity-text-outline-color: #192013; text-shadow: 0 3px 0 #192013; }
.editor-button.yellow > .vector-caption { -unity-text-outline-color: #43220c; text-shadow: 0 3px 0 #43220c; }
.editor-button.red > .vector-caption { -unity-text-outline-color: #35130f; text-shadow: 0 3px 0 #35130f; }
.editor-square { min-width: 116px; width: 116px; padding: 0; }
.editor-square > .vector-caption { font-size: 44px; }
.editor-remove { min-width: 160px; padding: 0 14px; }
.editor-bus-chips { flex-grow: 1; flex-basis: 0; min-width: 0; flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.editor-bus-chips > .editor-color-button { width: 70px; height: 66px; margin: 4px; font-size: 32px; }
.editor-level { flex-grow: 1; flex-basis: 0; min-width: 170px; margin: 4px; height: 76px; }
.editor-field { flex-direction: row; align-items: center; width: 210px; min-width: 0; margin: 4px; height: 76px; }
.portrait .editor-field { flex-shrink: 1; }
.editor-field > .unity-base-field__label { width: auto; min-width: 0; margin-right: 10px; font-size: 28px; }
.editor-time { width: 250px; }
.editor-root .unity-base-field__input {
    min-width: 0; background-color: rgb(14, 33, 82); color: white; border-color: rgb(9, 13, 34); border-width: 3px; border-radius: 16px;
    padding: 5px 12px; font-size: 32px;
}
.editor-root .unity-base-field__input:hover { border-color: rgb(255, 228, 90); }
.editor-root .unity-text-field__input { -unity-text-align: middle-center; }
.editor-root .unity-base-popup-field__text { font-size: 30px; }
.editor-root .unity-base-popup-field__arrow { -unity-background-image-tint-color: white; }
.editor-buses { padding: 12px 22px 8px 22px; flex-shrink: 0; }
.editor-buses > .editor-row { flex-wrap: wrap; }
.editor-caption { font-size: 32px; padding: 2px; margin: 0 14px 0 0; white-space: normal; }
.editor-small { font-size: 24px; margin: 0; padding: 0; white-space: normal; color: rgb(223, 232, 255); }
.editor-tip { flex-grow: 1; flex-basis: 0; min-width: 200px; -unity-text-align: middle-right; }
.editor-add-row { justify-content: flex-start; flex-wrap: wrap; }
.editor-chip-actions { flex-grow: 1; justify-content: flex-end; }
.editor-color-button {
    width: 80px; height: 76px; flex-shrink: 0; margin: 5px; padding: 0;
    border-width: 4px; border-color: rgba(255, 255, 255, .85); border-radius: 18px;
    font-size: 38px; -unity-text-outline-color: #10121c; -unity-text-outline-width: 2.4px; text-shadow: 0 3px 0 rgba(8, 20, 35, .7);
}
.editor-color-button:hover { border-color: rgb(255, 228, 90); }
.editor-color-button:active { scale: .92 .92; }
.editor-color-button:disabled, .editor-color-button.unavailable { opacity: .3; }
.editor-color-button.selected { border-color: rgb(255, 228, 90); border-width: 7px; }
.editor-chip-scroll { height: 96px; flex-shrink: 0; }
.editor-chip-scroll > .unity-scroll-view__content-viewport { flex-grow: 1; }
.editor-workspace { flex-grow: 1; min-height: 100px; flex-direction: row; padding: 3px 0; }
.editor-palette { width: 190px; max-width: 25%; flex-shrink: 0; padding: 14px 6px; }
.editor-palette > .editor-caption { margin: 0; font-size: 28px; }
.editor-palette-scroll { flex-grow: 1; min-height: 0; }
.editor-board-space { flex-grow: 1; }
.editor-palette-item { align-items: center; border-width: 4px; border-color: transparent; border-radius: 18px; margin: 3px 4px; padding: 6px 2px; height: 134px; flex-shrink: 0; }
.editor-palette-item > Label { margin: 0; padding: 0; }
.editor-palette-item:hover { background-color: rgba(150, 200, 255, .15); }
.editor-palette-item.selected { border-color: rgb(255, 228, 90); background-color: rgba(255, 225, 80, .2); }
.editor-palette-item.exhausted { opacity: .45; }
.editor-palette-item.overfilled { color: rgb(255, 115, 100); opacity: 1; }
.editor-passenger-icon { width: 58px; height: 62px; background-image: url("Vector/ui_passenger_icon.svg"); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.editor-footer { flex-shrink: 0; padding: 12px 22px 14px 22px; }
.editor-result-scroll { flex-grow: 1; flex-basis: 0; height: 88px; margin-left: 14px; }
.editor-result { font-size: 26px; white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; }
.editor-status { font-size: 24px; white-space: normal; -unity-text-align: upper-left; margin: 6px 4px 0 4px; padding: 0; }
.editor-overlay { background-color: rgba(5, 5, 13, .6); }
.editor-modal { width: 800px; max-width: 94%; max-height: 90%; padding: 168px 38px 40px 38px; justify-content: flex-start; align-items: stretch; }
.editor-modal > .raster-panel-art {
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("Vector/surface_result_modal.svg");
    -unity-slice-left: 110; -unity-slice-right: 110; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: .48px;
}
.editor-modal .modal-title { font-size: 46px; }
.editor-modal-body { flex-shrink: 1; min-height: 0; }
.editor-modal-body > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items: stretch; }
.editor-socket {
    background-image: url("Vector/surface_result_inner.svg"); -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 83; -unity-slice-right: 83; -unity-slice-top: 83; -unity-slice-bottom: 83; -unity-slice-scale: .4px;
    padding: 20px 26px; margin: 0 0 16px 0; flex-shrink: 0;
}
.editor-socket-row { flex-direction: row; align-items: center; height: 124px; padding-top: 0; padding-bottom: 0; }
.editor-socket-label { font-size: 36px; -unity-text-align: middle-left; margin: 0 0 6px 0; padding: 0; flex-grow: 1; }
/* Soket açık renkli: yazılar oyundaki ses toggle'ı gibi koyu konturlu. */
.editor-socket Label, .editor-modal .sound-toggle > .unity-toggle__label { color: white; -unity-text-outline-color: #191919; -unity-text-outline-width: 2px; text-shadow: 0 2px 0 #242424; }
.editor-socket .editor-small { font-size: 26px; -unity-text-outline-width: 1.8px; }
.editor-value { width: 96px; font-size: 54px; margin: 0; padding: 0; }
.editor-direction-row { justify-content: space-between; margin-top: 6px; }
.editor-direction { flex-grow: 1; flex-basis: 0; min-width: 0; height: 92px; padding: 0; }
.editor-socket > .editor-chip-scroll { margin: 8px 0 4px 0; }
.editor-socket > .editor-chip-actions { margin-bottom: 10px; }
.editor-modal .sound-toggle { position: relative; left: 0; right: 0; top: 0; width: auto; height: 124px; margin: 0 0 16px 0; padding: 0 36px 0 26px; }
.editor-modal .sound-toggle > .unity-toggle__label { font-size: 36px; -unity-text-align: middle-left; }
.editor-modal .sound-toggle .unity-toggle__checkmark, .editor-modal .sound-toggle > .unity-toggle__input { width: 84px; min-width: 84px; height: 84px; }
.editor-cloak { flex-direction: row; align-items: center; height: 84px; margin: 0; }
.editor-cloak > .unity-base-field__label { font-size: 36px; width: auto; min-width: 0; margin-right: 20px; }
.editor-cloak > .unity-base-field__input { flex-grow: 1; min-height: 76px; }
.editor-note { -unity-text-align: middle-center; margin: 0 10px 12px 10px; }
.editor-wide { align-self: center; width: 420px; height: 110px; margin: 6px 0 0 0; }
.editor-wide > .vector-caption { font-size: 38px; }
.editor-ghost { position: absolute; left: 0; top: 0; width: 88px; height: 120px; opacity: .85; background-image: url("Vector/ui_passenger_icon.svg"); -unity-background-scale-mode: scale-to-fit; }
.square .editor-top, .landscape .editor-top { flex-direction: row; }
.landscape .editor-top > .editor-row { flex-grow: 1; flex-basis: 0; }
.square .editor-field, .landscape .editor-field { flex-grow: 1; flex-basis: 0; }
.square .editor-top { flex-direction: column; }
.square .editor-palette, .landscape .editor-palette { width: 220px; }
.landscape .editor-result-scroll { height: 70px; }
.editor-root .unity-scroll-view__content-viewport { min-width: 0; }
.unity-base-dropdown__container-outer { background-color: rgb(10, 32, 71); border-color: rgb(102, 157, 211); border-width: 2px; border-radius: 8px; }
.unity-base-dropdown__item { color: white; min-height: 58px; }
.unity-base-dropdown__item:hover { background-color: rgb(41, 82, 184); }
.unity-base-dropdown__item:checked { background-color: rgb(41, 82, 184); color: rgb(255, 228, 90); }
.unity-base-dropdown__container-inner { background-color: rgb(10, 32, 71); }

/* Source-matched SVG decoration keeps every control's layout and picking. */
.vector-art { position: absolute; left: 1.5%; right: 1.5%; top: 2%; bottom: 8%; }
.vector-caption { flex-grow: 1; align-self: stretch; margin: 0; padding: 0; -unity-text-align: middle-center; }
.art-button > .vector-caption { padding-bottom: 12px; font-size: 44px; -unity-text-outline-width: 2px; -unity-text-outline-color: #192013; text-shadow: 0 3px 0 #192013; }
.art-button.red > .vector-caption { font-size: 39px; -unity-text-outline-color: #35130f; text-shadow: 0 3px 0 #35130f; }
.art-button.yellow > .vector-caption { -unity-text-outline-color: #43220c; text-shadow: 0 3px 0 #43220c; }
.art-button, .editor-button { border-width: 0; background-color: transparent; color: white; -unity-font-style: normal; justify-content: center; align-items: stretch; }
.art-button > .vector-art, .art-button > .vector-caption { transition-property: scale; transition-duration: .08s; }
.art-button:active > .vector-art, .art-button:active > .vector-caption { scale: .94 .94; }
.art-button { margin: 0; padding: 0; }
.editor-button > .vector-art, .editor-button > .vector-caption { transition-property: scale; transition-duration: .08s; }
.editor-button:active > .vector-art, .editor-button:active > .vector-caption { scale: .94 .94; }
.art-button:disabled, .editor-button:disabled { opacity: .5; }
/* Slice margins contain each complete corner, rim and shadow before stretching. */
.raster-button-art { left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 140; -unity-slice-right: 140;
    -unity-slice-top: 155; -unity-slice-bottom: 155; -unity-slice-scale: .44px;
}
.editor-button > .raster-button-art { -unity-slice-scale: .2px; }
.raster-button-art.vector-green { background-image: url("Vector/button_green_normal.svg"); }
.raster-button-art.vector-red { background-image: url("Vector/button_red_normal.svg"); }
.raster-button-art.vector-yellow { background-image: url("Vector/button_yellow_normal.svg"); }
.art-button:hover .raster-button-art.vector-green, .editor-button:hover .raster-button-art.vector-green { background-image: url("Vector/button_green_hover.svg"); }
.art-button:hover .raster-button-art.vector-red, .editor-button:hover .raster-button-art.vector-red { background-image: url("Vector/button_red_hover.svg"); }
.art-button:hover .raster-button-art.vector-yellow, .editor-button:hover .raster-button-art.vector-yellow { background-image: url("Vector/button_yellow_hover.svg"); }
.art-button:active .raster-button-art.vector-green, .editor-button:active .raster-button-art.vector-green { background-image: url("Vector/button_green_pressed.svg"); }
.art-button:active .raster-button-art.vector-red, .editor-button:active .raster-button-art.vector-red { background-image: url("Vector/button_red_pressed.svg"); }
.art-button:active .raster-button-art.vector-yellow, .editor-button:active .raster-button-art.vector-yellow { background-image: url("Vector/button_yellow_pressed.svg"); }
.start-button .raster-button-art.vector-green { background-image: url("Vector/button_start_normal.svg"); }
.start-button:hover .raster-button-art.vector-green { background-image: url("Vector/button_start_hover.svg"); }
.start-button:active .raster-button-art.vector-green { background-image: url("Vector/button_start_pressed.svg"); }
.raster-panel-art { -unity-background-scale-mode: stretch-to-fill; }
.raster-panel-art.vector-white { left: 6px; right: 7px; top: 9px; bottom: 10px; }
.raster-panel-art.vector-header { left: 5px; right: 5px; top: 13px; bottom: 13px; }
.raster-panel-art.vector-modal { left: 18px; right: 20px; top: 16px; bottom: 25px; }
.raster-panel-art.vector-badge { left: 0; right: 0; top: 0; bottom: 0; background-image: url("Vector/hud_level_badge.svg"); -unity-background-scale-mode: scale-to-fit; }
.counter > .raster-panel-art.vector-white, .timer-counter > .raster-panel-art.vector-header {
    left: 42px; right: 0; top: 12px; bottom: 8px;
    background-image: url("Vector/hud_counter.svg");
    -unity-slice-left: 85; -unity-slice-right: 85;
    -unity-slice-top: 88; -unity-slice-bottom: 88; -unity-slice-scale: .35px;
}
.start-bar .counter > .raster-panel-art.vector-white {
    left: 54.6px; top: 15.6px; bottom: 10.4px; -unity-slice-scale: .455px;
}
.start-button > .raster-button-art { -unity-slice-scale: .572px; }
.raster-panel-art.vector-blue { left: 2px; right: 3px; top: 2px; bottom: 3px; }
.confirm-modal > .vector-white { left: 16px; right: 18px; top: 23px; bottom: 25px; }
.vector-check-stroke { position: absolute; left: 34%; top: 24%; width: 26%; height: 45%; border-width: 0; border-right-width: 7px; border-bottom-width: 7px; border-color: #FEFEFE; rotate: 40deg; display: none; }
.sound-toggle:checked .vector-check { display: flex; }
.sound-toggle .unity-toggle__input { background-color: transparent; border-width: 0; }


/* ZUIR-3: shared blue popup family; all live captions and native controls remain. */
.settings-modal, .pause-modal, .confirm-modal, .no-lives-modal {
    width: 510px; padding: 0; min-height: 0; justify-content: flex-start;
}
.settings-modal { height: 520px; }
.pause-modal { height: 730px; }
.confirm-modal { width: 540px; height: 480px; }
.settings-modal > .raster-panel-art, .pause-modal > .raster-panel-art,
.confirm-modal > .raster-panel-art, .no-lives-modal > .raster-panel-art {
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("Vector/surface_result_modal.svg");
    -unity-slice-left: 110; -unity-slice-right: 110;
    -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: .48px;
}
.modal-heading {
    position: absolute; left: 22px; right: 22px; top: 20px;
    width: auto; height: 126px; padding: 0; justify-content: center;
}
.modal-heading > .raster-panel-art.vector-header, .no-lives-modal > .modal-title {
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("Vector/surface_result_header.svg");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 130; -unity-slice-right: 130;
    -unity-slice-top: 125; -unity-slice-bottom: 35; -unity-slice-scale: .5px;
}
.modal-title { font-size: 52px; padding: 0; margin: 0; color: #fff9df; -unity-text-outline-color: #090d16; -unity-text-outline-width: 2.7px; text-shadow: 0 3px 0 #07101e; }
.modal-heading > .close-button { position: absolute; top: -38px; right: -40px; }
.settings-modal > .art-button { position: absolute; top: 260px; }
.settings-modal > .art-button > .vector-caption { font-size: 33px; }
.pause-modal > .art-button { position: absolute; }
#restart-button { top: 382px; }
#menu-button { top: 550px; }
.pause-modal > .art-button > .vector-caption { font-size: 40px; }
.confirmation { position: absolute; left: 35px; right: 35px; top: 180px; width: auto; }
.confirmation > .question, .confirm-modal > .question {
    background-image: url("Vector/surface_result_inner.svg"); -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 83; -unity-slice-right: 83; -unity-slice-top: 83; -unity-slice-bottom: 83; -unity-slice-scale: .48px;
    font-size: 35px; color: white; -unity-text-outline-color: #191919; -unity-text-outline-width: 2px; text-shadow: 0 2px 0 #242424;
}
.confirmation > .question { width: 100%; height: 140px; margin: 0 0 30px 0; padding: 25px; }
.confirm-modal > .question { position: absolute; left: 34px; right: 34px; top: 42px; height: 230px; margin: 0; padding: 35px; }
.confirm-modal > .button-row { position: absolute; left: 35px; right: 35px; top: 310px; width: auto; }
.button-row .art-button { height: 124px; min-height: 110px; font-size: 40px; }
.button-row .vector-caption { font-size: 40px; }
.sound-toggle { position: absolute; left: 35px; right: 35px; top: 190px; width: auto; height: 150px; padding: 0 25px; margin: 0; }
.sound-toggle > .raster-panel-art.vector-white {
    left: 0; right: 0; top: 0; bottom: 0; background-image: url("Vector/surface_result_inner.svg");
    -unity-slice-left: 83; -unity-slice-right: 83; -unity-slice-top: 83; -unity-slice-bottom: 83; -unity-slice-scale: .48px;
}
.sound-toggle > .unity-toggle__label { font-size: 36px; color: white; -unity-text-outline-color: #191919; -unity-text-outline-width: 2px; text-shadow: 0 2px 0 #242424; }
.sound-toggle .unity-toggle__checkmark > .raster-panel-art.vector-blue { left: 0; right: 0; top: 0; bottom: 0; background-image: url("Vector/toggle_round_off.svg"); -unity-background-scale-mode: scale-to-fit; }
.sound-toggle:checked .unity-toggle__checkmark > .raster-panel-art.vector-blue { background-image: url("Vector/toggle_round_on.svg"); }
.sound-toggle .vector-check-stroke { left: 37%; top: 27%; width: 24%; height: 39%; border-right-width: 6px; border-bottom-width: 6px; border-color: #fff9df; }
.no-lives-modal { width: 522px; height: 700px; }
.no-lives-modal > .raster-panel-art {
    background-image: url("Vector/surface_lives_modal.svg");
    -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0;
}
.no-lives-modal > .modal-title { position: absolute; left: 22px; right: 22px; top: 20px; bottom: auto; height: 126px; flex-grow: 0; }
.no-lives-modal > .heart-icon { position: absolute; top: 205px; width: 240px; height: 240px; }
.no-lives-modal .lives-count { font-size: 100px; -unity-text-outline-width: 4px; text-shadow: 0 4px 0 #42151d; }
#no-lives-countdown {
    position: absolute; top: 500px; width: 218px; height: 66px; margin: 0; padding: 0; font-size: 40px;
    background-image: url("Vector/hud_counter.svg"); -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 85; -unity-slice-right: 85; -unity-slice-top: 88; -unity-slice-bottom: 88; -unity-slice-scale: .35px;
    -unity-text-outline-color: #10121c; -unity-text-outline-width: 1.6px; text-shadow: 0 2px 0 #081423;
}
.no-lives-hint { position: absolute; top: 600px; left: 55px; right: 55px; font-size: 27px; margin: 0; padding: 0; }
.lives-time-label { position: absolute; top: 446px; left: 20px; right: 20px; height: 46px; margin: 0; padding: 0; font-size: 38px; -unity-text-outline-color: #0b1530; -unity-text-outline-width: 2px; text-shadow: 0 3px 0 #0b1530; }
.tutorial-tip { width: 350px; max-width: 92%; padding: 18px 22px; -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28; -unity-slice-scale: .393px; }
.tutorial-hint { font-size: 22px; color: white; -unity-text-outline-color: #19171e; -unity-text-outline-width: 1.5px; text-shadow: 0 2px 0 #17151e; }

/* ZHUD-2: live level caption above the counter surface. */
.timer-level { position: absolute; left: 42px; right: 0; top: -18px; height: 27px; margin: 0; padding: 0; font-size: 21px; color: white; -unity-text-outline-color: #10121c; -unity-text-outline-width: 1.2px; text-shadow: 0 2px 0 #081423; }

/* T2: reference phone HUD. Values are reference pixels (739x1600 capture); ToolkitGameUI.Layout scales the columns by screen height. */
.hud-column { position: absolute; left: 50%; width: 739px; translate: -50% 0; }
.hud-top { top: 0; height: 100px; transform-origin: 50% 0; }
.hud-top > .level-badge { position: absolute; left: 90px; top: 0; width: 100px; height: 100px; padding-top: 2px; }
.hud-top .level-title { height: 26px; font-size: 26px; color: #1d3c91; -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent; }
.hud-top .level-number { height: 52px; font-size: 54px; color: white; -unity-text-outline-color: #15141d; -unity-text-outline-width: 3px; text-shadow: 0 2px 0 rgba(21, 20, 29, 0.45); }
.hud-top > .timer-counter { position: absolute; left: 289px; top: 22px; width: 160px; height: 56px; padding-right: 8px; }
.hud-top .clock-icon { width: 54px; height: 56px; }
.hud-top .timer-text { font-size: 30px; }
.hud-top .timer-level { display: none; }
.hud-top > .timer-counter > .raster-panel-art.vector-header { left: 28px; top: 8px; bottom: 6px; -unity-slice-scale: .24px; }
.hud-top > .gear { position: absolute; left: 575px; top: 17px; width: 79px; height: 81px; }
.booster-bar { height: 111px; flex-direction: row; padding-left: 70px; transform-origin: 50% 100%; }
.booster-track { position: absolute; left: 48px; right: 49px; top: 18px; height: 86px; background-image: url("Vector/booster_bar.svg"); -unity-background-scale-mode: stretch-to-fill; }
.booster-lock { width: 127px; height: 111px; margin-right: 31px; flex-shrink: 0; background-image: url("Vector/booster_locked.svg"); -unity-background-scale-mode: stretch-to-fill; }
.booster-label {
    position: absolute; left: 7px; top: 83px; width: 111px; height: 28px; margin: 0; padding: 0;
    background-color: #f7b80f; border-radius: 9px; border-width: 2px; border-color: #c27b04;
    font-size: 23px; color: #8c1212; -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent;
}
.ad-banner { position: absolute; left: 0; right: 0; bottom: 0; height: 93px; background-color: rgb(251, 251, 251); border-top-width: 1px; border-color: rgb(141, 141, 141); align-items: center; justify-content: center; }
.ad-label { font-size: 22px; color: rgba(0, 0, 0, 0.3); -unity-text-outline-width: 0; text-shadow: 0 0 0 transparent; }
.editor-return { position: absolute; left: 24px; top: 200px; width: 180px; }
