<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:art="BusJam.UI">
    <ui:Style src="Theme.uss" />
    <ui:VisualElement name="ui-root" class="ui-root portrait" picking-mode="Ignore">
        <ui:VisualElement name="menu-background" class="fill menu-background" picking-mode="Ignore" />
        <ui:VisualElement name="ready-dim" class="fill ready-dim hidden" picking-mode="Ignore" />
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">
            <ui:VisualElement name="start-screen" class="fill start-screen" picking-mode="Ignore">
                <ui:VisualElement class="top-bar start-bar" picking-mode="Ignore">
                    <ui:VisualElement class="counter lives-plate" picking-mode="Ignore">
                        <ui:VisualElement class="heart-icon" picking-mode="Ignore"><ui:Label name="lives-count" text="5" class="lives-count" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:Label name="life-countdown" text="FULL" class="counter-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="counter coins-plate" picking-mode="Ignore">
                        <ui:VisualElement class="coin-icon" picking-mode="Ignore" />
                        <ui:Label name="coin-count" text="0" class="counter-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="start-settings" class="gear" tooltip="Settings" />
                </ui:VisualElement>
                <ui:VisualElement class="start-body" picking-mode="Ignore">
                    <ui:VisualElement name="logo" class="logo" picking-mode="Ignore" />
                    <art:VectorButton name="start-button" text="Level 1" class="art-button green start-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hud" class="top-bar hud hidden" picking-mode="Ignore">
                <ui:VisualElement class="level-badge" picking-mode="Ignore">
                    <ui:Label text="Level" class="level-title" picking-mode="Ignore" />
                    <ui:Label name="level-number" text="1" class="level-number" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="timer-counter" picking-mode="Ignore">
                    <ui:VisualElement class="clock-icon" picking-mode="Ignore" />
                    <ui:Label name="timer-text" text="0:30" class="timer-text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="pause-settings" class="gear" tooltip="Settings" />
            </ui:VisualElement>
            <ui:VisualElement name="ready-overlay" class="fill ready-overlay hidden" picking-mode="Ignore">
                <ui:Label name="ready-prompt" text="Tap to start" class="ready-prompt" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="tutorial-overlay" class="fill tutorial-overlay" picking-mode="Ignore">
                <ui:VisualElement name="tutorial-tip" class="tutorial-tip hidden" picking-mode="Ignore">
                    <ui:Label name="tutorial-hint" class="tutorial-hint" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="tutorial-pointer" class="tutorial-pointer hidden" picking-mode="Ignore" usage-hints="DynamicTransform">
                    <ui:VisualElement name="tutorial-ring" class="tutorial-ring" picking-mode="Ignore" usage-hints="DynamicTransform" />
                    <ui:VisualElement name="tutorial-burst" class="fill" picking-mode="Ignore" />
                    <ui:VisualElement name="tutorial-hand" class="tutorial-hand" picking-mode="Ignore" usage-hints="DynamicTransform" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="complete-overlay" class="fill result-overlay hidden">
                <ui:Image name="celebration-bus" class="fill" picking-mode="Ignore" />
                <ui:VisualElement class="top-bar result-bar" picking-mode="Ignore">
                    <ui:VisualElement name="result-coin-plate" class="counter coins-plate" picking-mode="Ignore">
                        <ui:VisualElement class="coin-icon" picking-mode="Ignore" />
                        <ui:Label name="result-coins" text="0" class="counter-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="complete-body" class="result-body" picking-mode="Ignore">
                    <ui:VisualElement name="complete-panel" class="result-content" picking-mode="Ignore">
                        <ui:VisualElement name="complete-heading" class="result-heading" picking-mode="Ignore">
                            <ui:VisualElement name="complete-rays" class="fill result-rays" picking-mode="Ignore" usage-hints="DynamicTransform" />
                            <ui:VisualElement name="complete-title-group" class="fill" picking-mode="Ignore" usage-hints="DynamicTransform">
                                <ui:VisualElement class="complete-ribbon" picking-mode="Ignore" />
                                <ui:VisualElement name="complete-title" class="complete-title" picking-mode="Ignore" tooltip="Level Completed!" />
                            </ui:VisualElement>
                            <ui:VisualElement name="complete-sparkles" class="fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="reward-content" class="reward-content" picking-mode="Ignore">
                            <ui:VisualElement name="reward-flash" class="fill reward-flash" picking-mode="Ignore" />
                            <ui:VisualElement name="reward-pile" class="reward-pile" picking-mode="Ignore" />
                            <ui:VisualElement name="pile-glints" class="fill" picking-mode="Ignore" />
                            <ui:Label name="reward-label" text="+25" class="reward-label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="continue-wrap" class="continue-wrap" picking-mode="Ignore">
                            <ui:VisualElement name="continue-glow" class="fill continue-glow" picking-mode="Ignore" />
                            <art:VectorButton name="continue-button" text="Continue" class="art-button green" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="celebration-effects" class="fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="fail-overlay" class="fill modal-overlay hidden">
                <ui:VisualElement class="top-bar fail-bar" picking-mode="Ignore">
                    <ui:VisualElement class="counter lives-plate" picking-mode="Ignore">
                        <ui:VisualElement name="fail-hud-heart" class="heart-icon" picking-mode="Ignore"><ui:Label name="fail-lives-count" text="5" class="lives-count" picking-mode="Ignore" /></ui:VisualElement>
                        <ui:Label name="fail-countdown" text="FULL" class="counter-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="fail-panel" class="modal fail-modal">
                    <ui:VisualElement class="fail-heading">
                        <ui:Button name="fail-close" class="close-button" tooltip="Close" />
                        <ui:VisualElement name="fail-title" class="fail-title" picking-mode="Ignore" tooltip="Level Failed!" />
                    </ui:VisualElement>
                    <ui:Label name="fail-level" text="Level 1" class="fail-level" picking-mode="Ignore" />
                    <ui:VisualElement class="life-loss" picking-mode="Ignore">
                        <ui:VisualElement name="fail-icon" class="fail-icon broken-heart" picking-mode="Ignore" />
                        <ui:Label name="life-cost" text="-1" class="life-cost" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="fail-reason" text="No space left!" class="question fail-reason" picking-mode="Ignore" />
                    <art:VectorButton name="retry-button" text="Try Again" class="art-button green" />
                </ui:VisualElement>
                <ui:VisualElement name="fail-effects" class="fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="no-lives-overlay" class="fill modal-overlay hidden" picking-mode="Ignore">
                <ui:VisualElement class="modal no-lives-modal" picking-mode="Ignore">
                    <ui:Label text="No lives" class="modal-title" picking-mode="Ignore" />
                    <ui:VisualElement class="heart-icon" picking-mode="Ignore">
                        <ui:Label name="no-lives-count" text="0" class="lives-count" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="no-lives-countdown" text="Next life in 20:00" class="question" picking-mode="Ignore" />
                    <ui:Label text="Lives refill automatically." class="no-lives-hint" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="settings-overlay" class="fill modal-overlay hidden">
                <ui:VisualElement class="modal settings-modal">
                    <ui:VisualElement class="modal-heading">
                        <ui:Label text="Settings" class="modal-title" />
                        <ui:Button name="settings-close" class="close-button" tooltip="Close" />
                    </ui:VisualElement>
                    <art:VectorButton name="reset-button" text="Reset Progress" class="art-button red" />
                    <ui:VisualElement name="reset-confirmation" class="confirmation hidden">
                        <ui:Label text="Are you sure?" class="question" />
                        <ui:VisualElement class="button-row">
                            <art:VectorButton name="reset-yes" text="Yes" class="art-button red" />
                            <art:VectorButton name="reset-no" text="No" class="art-button green" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="pause-overlay" class="fill modal-overlay hidden">
                <ui:VisualElement class="modal pause-modal">
                    <ui:VisualElement class="modal-heading">
                        <ui:Label text="Settings" class="modal-title" />
                        <ui:Button name="pause-close" class="close-button" tooltip="Close" />
                    </ui:VisualElement>
                    <ui:Toggle name="sound-toggle" class="sound-toggle" label="Sound: ON" value="true" />
                    <art:VectorButton name="restart-button" text="Restart" class="art-button green" />
                    <art:VectorButton name="menu-button" text="Main Menu" class="art-button yellow" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="pause-confirmation" class="fill modal-overlay hidden">
                <ui:VisualElement class="modal confirm-modal">
                    <ui:Label name="confirm-text" text="Restart this level?&#10;You will lose a life." class="question" />
                    <ui:VisualElement class="button-row">
                        <art:VectorButton name="confirm-yes" text="Yes" class="art-button red" />
                        <art:VectorButton name="confirm-no" text="No" class="art-button green" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
