<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:art="BusJam.UI">
    <ui:Style src="Theme.uss" />
    <ui:VisualElement name="editor-root" class="ui-root editor-root portrait" picking-mode="Ignore">
        <ui:VisualElement name="editor-safe" class="editor-safe" picking-mode="Ignore">
            <ui:VisualElement class="editor-top editor-surface">
                <ui:VisualElement class="editor-row" picking-mode="Ignore">
                    <ui:DropdownField name="level-list" class="editor-level" tooltip="Pick a level to edit" />
                    <art:VectorButton name="load" text="Load" class="editor-button yellow" tooltip="Reload the picked level" />
                    <art:VectorButton name="new" text="New" class="editor-button yellow" tooltip="Start an empty level" />
                    <art:VectorButton name="save" text="Save" class="editor-button green" />
                    <art:VectorButton name="test" text="Test Play" class="editor-button green" tooltip="Save, then play this level in the game" />
                </ui:VisualElement>
                <ui:VisualElement class="editor-row" picking-mode="Ignore">
                    <ui:TextField name="width" label="Width" value="5" max-length="2" class="editor-field" />
                    <ui:TextField name="height" label="Height" value="6" max-length="2" class="editor-field" />
                    <art:VectorButton name="apply" text="Apply" class="editor-button yellow" tooltip="Resize the grid" />
                    <ui:TextField name="seconds" label="Time (s)" value="60" max-length="4" class="editor-field editor-time" />
                    <art:VectorButton name="auto-grid" text="Auto Grid" class="editor-button yellow" tooltip="Generate holes, obstacles and a tunnel for this size" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="editor-buses editor-surface">
                <ui:VisualElement class="editor-row" picking-mode="Ignore">
                    <ui:Label name="bus-summary" text="Buses: add at least one" class="editor-caption" picking-mode="Ignore" />
                    <ui:Label text="Tap + to add · tap a bus to move or remove it" class="editor-small editor-tip" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="bus-add" class="editor-row editor-add-row" picking-mode="Ignore" />
                <ui:VisualElement class="editor-row" picking-mode="Ignore">
                    <ui:ScrollView name="bus-scroll" mode="Horizontal" class="editor-chip-scroll editor-bus-chips" />
                    <art:VectorButton name="bus-left" text="&lt;" class="editor-button yellow editor-square" tooltip="Move earlier" />
                    <art:VectorButton name="bus-right" text="&gt;" class="editor-button yellow editor-square" tooltip="Move later" />
                    <art:VectorButton name="bus-remove" text="Remove" class="editor-button red editor-remove" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="editor-workspace" picking-mode="Ignore">
                <ui:VisualElement class="editor-palette editor-surface">
                    <ui:Label text="Passengers" class="editor-caption" picking-mode="Ignore" />
                    <ui:Label text="placed / needed" class="editor-small" picking-mode="Ignore" />
                    <ui:ScrollView name="palette" mode="Vertical" vertical-scroller-visibility="Hidden" class="editor-palette-scroll" />
                </ui:VisualElement>
                <ui:VisualElement class="editor-board-space" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="editor-footer editor-surface">
                <ui:VisualElement class="editor-row" picking-mode="Ignore">
                    <art:VectorButton name="solve" text="Solve" class="editor-button green" tooltip="Check that the level can be won" />
                    <art:VectorButton name="auto-fill" text="Auto Fill" class="editor-button yellow" tooltip="Place the missing passengers in a solvable layout" />
                    <ui:ScrollView class="editor-result-scroll"><ui:Label name="solver-result" class="editor-result" picking-mode="Ignore" /></ui:ScrollView>
                </ui:VisualElement>
                <ui:Label name="status" text="Pick a level to edit." class="editor-status" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="passenger-overlay" class="fill modal-overlay editor-overlay hidden">
                <ui:VisualElement class="modal editor-modal">
                    <ui:VisualElement class="modal-heading">
                        <ui:Label name="passenger-title" text="Passenger" class="modal-title" picking-mode="Ignore" />
                        <ui:Button name="passenger-close" class="close-button" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:ScrollView class="editor-modal-body">
                        <ui:Toggle name="hidden-passenger" label="Hidden (?)" class="sound-toggle editor-toggle" />
                        <ui:VisualElement class="editor-socket editor-socket-row">
                            <ui:Label text="Ropes" class="editor-socket-label" picking-mode="Ignore" />
                            <art:VectorButton name="ropes-minus" text="-" class="editor-button yellow editor-square" />
                            <ui:Label name="ropes" text="0" class="editor-value" picking-mode="Ignore" />
                            <art:VectorButton name="ropes-plus" text="+" class="editor-button yellow editor-square" />
                        </ui:VisualElement>
                        <ui:VisualElement class="editor-socket">
                            <ui:DropdownField name="cloak" label="Cloak" class="editor-cloak" />
                        </ui:VisualElement>
                        <ui:Label text="Hidden and cloak can't be combined: turning one on turns the other off." class="editor-small editor-note" picking-mode="Ignore" />
                        <art:VectorButton name="delete-passenger" text="Remove" class="editor-button red editor-wide" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="tunnel-overlay" class="fill modal-overlay editor-overlay hidden">
                <ui:VisualElement class="modal editor-modal">
                    <ui:VisualElement class="modal-heading">
                        <ui:Label name="tunnel-title" text="Tunnel" class="modal-title" picking-mode="Ignore" />
                        <ui:Button name="tunnel-close" class="close-button" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:ScrollView class="editor-modal-body">
                        <ui:VisualElement class="editor-socket">
                            <ui:Label text="Exit side (R rotates)" class="editor-socket-label" picking-mode="Ignore" />
                            <ui:VisualElement class="editor-row editor-direction-row" picking-mode="Ignore">
                                <art:VectorButton name="face-Up" text="Up" class="editor-button yellow editor-direction" />
                                <art:VectorButton name="face-Down" text="Down" class="editor-button yellow editor-direction" />
                                <art:VectorButton name="face-Left" text="Left" class="editor-button yellow editor-direction" />
                                <art:VectorButton name="face-Right" text="Right" class="editor-button yellow editor-direction" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="editor-socket">
                            <ui:Label name="tunnel-count" text="Queue: empty" class="editor-socket-label" picking-mode="Ignore" />
                            <ui:Label text="The leftmost passenger comes out first." class="editor-small" picking-mode="Ignore" />
                            <ui:ScrollView name="tunnel-scroll" mode="Horizontal" class="editor-chip-scroll" />
                            <ui:VisualElement class="editor-row editor-chip-actions" picking-mode="Ignore">
                                <art:VectorButton name="tunnel-left" text="&lt;" class="editor-button yellow editor-square" tooltip="Move earlier" />
                                <art:VectorButton name="tunnel-right" text="&gt;" class="editor-button yellow editor-square" tooltip="Move later" />
                                <art:VectorButton name="tunnel-remove" text="Remove" class="editor-button red editor-remove" />
                            </ui:VisualElement>
                            <ui:Label text="Add to the queue:" class="editor-small" picking-mode="Ignore" />
                            <ui:VisualElement name="tunnel-add" class="editor-row editor-add-row" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <art:VectorButton name="delete-tunnel" text="Remove tunnel" class="editor-button red editor-wide" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="passenger-ghost" class="editor-ghost hidden" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
